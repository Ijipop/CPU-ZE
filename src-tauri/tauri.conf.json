{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPU-ZE",
  "version": "0.1.0",
  "identifier": "com.cpuze.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CPU-ZE",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0NDhDMDM2N0YwMEI2RDMKUldUVHRnQi9Oc0JJNUxtaWdoMDJkdjlmaG9Mc3VMalg5ZzBXaGtBSVFZK3VNUWZBa1BRc3o2OTIK",
      "endpoints": [
        "https://github.com/Ijipop/CPU-ZE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
