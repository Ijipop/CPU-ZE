{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPU-ZE",
  "version": "0.3.1",
  "identifier": "com.cpuze.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CPU-ZE",
        "width": 980,
        "height": 680,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/pawnio/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5NzMwNTU1OTE2QjY3QTcKUldTbloydVJWUVZ6ZWJSeXIzMCt5RkF5OTdaRHRDUzZJamRMR3VsSGpJYXZaQ1FIeExsV3RjbGkK",
      "endpoints": [
        "https://api.github.com/repos/Ijipop/CPU-ZE/contents/updater/latest.json?ref=release"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
